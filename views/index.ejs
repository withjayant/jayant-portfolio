<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ══════════════════════════════════════════
     HERO
══════════════════════════════════════════ -->
<section id="hero">
  <div class="hero-inner">
    <div class="hero-badge rev">
      <span class="badge-dot"></span> Open to Opportunities
    </div>
    <div class="hero-tag rev">
      <span class="line"></span>
      <%= data.personal.role %>
    </div>
    <h1 class="hero-name rev">
      <span class="hn-first"><%= data.personal.name.split(' ')[0] %></span><br/>
      <span class="hn-last"><%= data.personal.name.split(' ')[1] %></span>
    </h1>
    <p class="hero-tagline rev"><%= data.personal.tagline %></p>
    <p class="hero-bio rev"><%= data.personal.bio %></p>
    <div class="hero-cta rev">
      <a href="#projects" class="btn btn-primary">View Projects ↓</a>
      <a href="<%= data.personal.github %>" target="_blank" class="btn btn-ghost">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        GitHub
      </a>
      <a href="mailto:<%= data.personal.email %>" class="btn btn-ghost">Contact →</a>
    </div>
    <!-- Quick stats -->
    <div class="hero-stats rev">
      <div class="hs"><span class="hs-v" id="statSolved"><%= data.dsa.totalSolved %>+</span><span class="hs-l">DSA Solved</span></div>
      <div class="hs-div"></div>
      <div class="hs"><span class="hs-v" id="statRepos"><%= data.projects.length %> Repos</span><span class="hs-l">GitHub</span></div>
      <div class="hs-div"></div>
      <div class="hs"><span class="hs-v"><%= data.experience.length %>+</span><span class="hs-l">Experience</span></div>
      <div class="hs-div"></div>
      <div class="hs"><span class="hs-v"><%= data.achievements.length %></span><span class="hs-l">Certifications</span></div>
    </div>
  </div>
  <div class="scroll-hint"><div class="scroll-line"></div><span>scroll</span></div>
</section>

<!-- ══════════════════════════════════════════
     DSA TRACKER
══════════════════════════════════════════ -->
<section id="dsa" class="s-alt">
  <div class="s-head rev">
    <span class="s-num">01</span>
    <h2 class="s-title">DSA & Competitive Programming</h2>
    <div class="s-line"></div>
  </div>


  <!-- Live LeetCode Stats -->
  <div class="lc-live rev">
    <div class="lc-live-head">
      <span style="font-size:1.1rem">🟡</span>
      <span style="font-size:.85rem;font-weight:700;color:var(--text)">LeetCode — withjayant</span>
      <span class="live-badge"><span class="live-dot"></span> Real-time API</span>
    </div>
    <div class="lc-stats-row">
      <div class="lc-stat-item total"><span class="lc-val" id="lcTotalVal"><%= data.dsa.totalSolved %></span><span class="lc-lbl">Total</span></div>
      <div class="lc-stat-item easy"><span class="lc-val" id="lcEasyVal"><%= data.dsa.difficulty.easy %></span><span class="lc-lbl">Easy</span></div>
      <div class="lc-stat-item med"><span class="lc-val" id="lcMedVal"><%= data.dsa.difficulty.medium %></span><span class="lc-lbl">Medium</span></div>
      <div class="lc-stat-item hard"><span class="lc-val" id="lcHardVal"><%= data.dsa.difficulty.hard %></span><span class="lc-lbl">Hard</span></div>
    </div>
  </div>

  <!-- Top row: total + difficulty ring + platform cards -->
  <div class="dsa-top rev">
    <div class="dsa-ring-wrap">
      <canvas id="diffDonut" width="180" height="180"></canvas>
      <div class="dsa-ring-center">
        <span class="dsa-big"><%= data.dsa.totalSolved %>+</span>
        <span class="dsa-lbl">Solved</span>
      </div>
    </div>
    <div class="dsa-platforms">
      <% data.dsa.platforms.forEach(p => { %>
      <a href="<%= p.url %>" target="_blank" class="plat-card">
        <div class="plat-top">
          <span class="plat-icon"><%= p.icon %></span>
          <span class="plat-name"><%= p.name %></span>
          <span class="plat-count" style="color:<%= p.color %>"><%= p.solved %></span>
        </div>
        <div class="plat-bar-bg">
          <div class="plat-bar" style="width:<%= Math.round(p.solved/p.total*100) %>%;background:<%= p.color %>"></div>
        </div>
        <span class="plat-sub"><%= p.solved %> / <%= p.total.toLocaleString() %> problems</span>
      </a>
      <% }) %>
    </div>
  </div>

  <!-- Difficulty badges -->
  <div class="diff-badges rev">
    <div class="diff-badge easy">
      <span class="diff-n"><%= data.dsa.difficulty.easy %></span>
      <span class="diff-l">Easy</span>
    </div>
    <div class="diff-badge med">
      <span class="diff-n"><%= data.dsa.difficulty.medium %></span>
      <span class="diff-l">Medium</span>
    </div>
    <div class="diff-badge hard">
      <span class="diff-n"><%= data.dsa.difficulty.hard %></span>
      <span class="diff-l">Hard</span>
    </div>
    <div class="diff-badge streak">
      <span class="diff-n"><%= data.dsa.streak %></span>
      <span class="diff-l">🔥 Day Streak</span>
    </div>
  </div>

  <!-- Topic progress bars -->
  <div class="dsa-topics rev">
    <h3 class="topics-title">Topic-wise Progress</h3>
    <div class="topics-grid">
      <% data.dsa.topics.forEach(t => { %>
      <div class="topic-row">
        <div class="topic-meta">
          <span class="topic-name"><%= t.name %></span>
          <span class="topic-count"><%= t.solved %>/<%= t.total %></span>
        </div>
        <div class="topic-bar-bg">
          <div class="topic-bar <%= t.pct >= 80 ? 'high' : t.pct >= 60 ? 'mid' : 'low' %>"
               style="width:0%" data-w="<%= t.pct %>%"></div>
        </div>
        <span class="topic-pct"><%= t.pct %>%</span>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- LeetCode CTA -->
  <div class="dsa-cta rev">
    <a href="<%= data.personal.leetcode %>" target="_blank" class="btn btn-primary">
      View LeetCode Profile ↗
    </a>
  </div>
</section>

<!-- ══════════════════════════════════════════
     SKILLS
══════════════════════════════════════════ -->
<section id="skills">
  <div class="s-head rev">
    <span class="s-num">02</span>
    <h2 class="s-title">Technical Skills</h2>
    <div class="s-line"></div>
  </div>
  <div class="skills-grid">
    <% data.skills.forEach(sk => { %>
    <div class="sk-card rev">
      <div class="sk-ico"><%= sk.icon %></div>
      <div class="sk-cat"><%= sk.cat %></div>
      <div class="sk-tags">
        <% sk.tags.forEach(t => { %><span class="tag"><%= t %></span><% }) %>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- ══════════════════════════════════════════
     EXPERIENCE
══════════════════════════════════════════ -->
<section id="experience" class="s-alt">
  <div class="s-head rev">
    <span class="s-num">03</span>
    <h2 class="s-title">Experience</h2>
    <div class="s-line"></div>
  </div>
  <% data.experience.forEach(ex => { %>
  <div class="exp-card rev">
    <div class="exp-top">
      <div>
        <div class="exp-badge"><span class="exp-dot"></span><%= ex.type %> · <%= ex.period %></div>
        <div class="exp-role"><%= ex.role %></div>
        <div class="exp-co"><%= ex.company %></div>
        <div class="exp-loc">📍 <%= ex.location %></div>
      </div>
    </div>
    <ul class="exp-list">
      <% ex.bullets.forEach(b => { %><li><%= b %></li><% }) %>
    </ul>
  </div>
  <% }) %>
</section>

<!-- ══════════════════════════════════════════
     PROJECTS
══════════════════════════════════════════ -->
<section id="projects">
  <div class="s-head rev">
    <span class="s-num">04</span>
    <h2 class="s-title">Projects</h2>
    <div class="s-line"></div>
  </div>


  <!-- Live GitHub Stats -->
  <div class="gh-live-bar rev">
    <span class="live-badge" style="margin-bottom:.8rem"><span class="live-dot"></span> GitHub — withjayant (Real-time)</span>
    <div class="gh-stats-row">
      <div class="gh-stat-item"><span class="gh-val" id="ghReposVal">—</span><span class="gh-lbl">Public Repos</span></div>
      <div class="gh-stat-item"><span class="gh-val" id="ghStarsVal">—</span><span class="gh-lbl">Total Stars</span></div>
      <div class="gh-stat-item"><span class="gh-val" id="ghFollowersVal">—</span><span class="gh-lbl">Followers</span></div>
    </div>
  </div>

  <!-- Featured projects -->
  <div class="feat-grid">
    <% data.projects.filter(p=>p.featured).forEach((p,i) => { %>
    <div class="feat-card rev <%= i%2===1 ? 'reverse' : '' %>">
      <div class="feat-img-wrap">
        <div class="feat-img-frame">
          <img src="<%= p.image %>" alt="<%= p.name %>" class="feat-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>
          <div class="feat-img-fallback" style="display:none">
            <span style="font-size:3.5rem"><%= p.icon %></span>
            <span style="color:var(--muted2);font-size:.8rem;margin-top:.5rem"><%= p.name %></span>
          </div>
          <div class="feat-img-overlay">
            <div class="feat-links">
              <% if(p.github) { %><a href="<%= p.github %>" target="_blank" class="feat-link">GitHub ↗</a><% } %>
              <% if(p.live)   { %><a href="<%= p.live   %>" target="_blank" class="feat-link live-link">Live ↗</a><% } %>
            </div>
          </div>
        </div>
      </div>
      <div class="feat-info">
        <div class="feat-meta"><span class="feat-num">0<%= i+1 %></span><span class="feat-date"><%= p.date %></span></div>
        <div class="feat-tag"><%= p.tagline %></div>
        <h3 class="feat-name"><%= p.name %></h3>
        <p class="feat-desc"><%= p.desc %></p>
        <div class="feat-stack">
          <% p.stack.forEach(s => { %><span class="chip"><%= s %></span><% }) %>
        </div>
        <div class="feat-actions">
          <% if(p.github) { %>
          <a href="<%= p.github %>" target="_blank" class="btn btn-ghost btn-sm2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            Source Code
          </a>
          <% } %>
          <% if(p.live) { %>
          <a href="<%= p.live %>" target="_blank" class="btn btn-primary btn-sm2">View Live ↗</a>
          <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Other projects -->
  <div class="other-proj-grid">
    <% data.projects.filter(p=>!p.featured).forEach(p => { %>
    <div class="proj-card rev">
      <div class="pc-top">
        <span class="pc-ico"><%= p.icon %></span>
        <div class="pc-links">
          <% if(p.github){ %><a href="<%= p.github %>" target="_blank" class="plink">↗</a><% } %>
        </div>
      </div>
      <div class="pc-date"><%= p.date %></div>
      <div class="pc-name"><%= p.name %></div>
      <div class="pc-tag"><%= p.tagline %></div>
      <div class="pc-desc"><%= p.desc %></div>
      <div class="pc-stack">
        <% p.stack.forEach(s=>{%><span class="chip2"><%= s %></span><%})%>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- ══════════════════════════════════════════
     BANK LOAN ANALYSIS
══════════════════════════════════════════ -->
<section id="bankloan" class="s-alt">
  <div class="s-head rev">
    <span class="s-num">05</span>
    <h2 class="s-title">Bank Loan Data Analysis</h2>
    <div class="s-line"></div>
  </div>

  <div class="bank-intro rev">
    <div class="bank-desc">
      <p>End-to-end Power BI dashboard suite analysing <strong>38,576 loan records</strong> worth <strong>$435.8M</strong>.
      Three interconnected dashboards cover KPI summaries, trend analysis, and borrower segmentation — with DAX-driven metrics, geographic heatmaps, and drill-through detail tables.</p>
      <div class="bank-tools">
        <% data.bankLoan.tools.forEach(t=>{%><span class="bank-tool"><%= t %></span><%})%>
      </div>
      <ul class="bank-features">
        <% data.bankLoan.features.forEach(f=>{%><li><%= f %></li><%})%>
      </ul>
    </div>
    <div class="bank-chart-side">
      <div class="chart-card">
        <div class="chart-title">Good vs Bad Loans</div>
        <div class="chart-wrap"><canvas id="loanDonut"></canvas></div>
      </div>
    </div>
  </div>

  <!-- Stat grid -->
  <div class="bank-stats-grid rev">
    <% data.bankLoan.stats.forEach(s => { %>
    <div class="bstat bstat-<%= s.color %>">
      <div class="bstat-label"><%= s.label %></div>
      <div class="bstat-val"><%= s.value %></div>
      <div class="bstat-sub"><%= s.sub %></div>
    </div>
    <% }) %>
  </div>

  <!-- Charts row -->
  <div class="bank-charts rev">
    <div class="chart-card">
      <div class="chart-title">Monthly Funded Amount</div>
      <div class="chart-wrap"><canvas id="loanTrend"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Loan Purpose Breakdown</div>
      <div class="chart-wrap"><canvas id="loanPurpose"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Loan Grade Distribution</div>
      <div class="chart-wrap"><canvas id="loanGrade"></canvas></div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════
     ACHIEVEMENTS
══════════════════════════════════════════ -->
<section id="achievements">
  <div class="s-head rev">
    <span class="s-num">06</span>
    <h2 class="s-title">Achievements & Certifications</h2>
    <div class="s-line"></div>
  </div>
  <div class="ach-grid">
    <% data.achievements.forEach(a => { %>
    <div class="ach-card rev">
      <div class="ach-ico"><%= a.icon %></div>
      <div class="ach-body">
        <h3><%= a.title %></h3>
        <p><%= a.desc %></p>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- ══════════════════════════════════════════
     EDUCATION
══════════════════════════════════════════ -->
<section id="education" class="s-alt">
  <div class="s-head rev">
    <span class="s-num">07</span>
    <h2 class="s-title">Education</h2>
    <div class="s-line"></div>
  </div>
  <div class="edu-card rev">
    <div class="edu-ico">🎓</div>
    <div class="edu-info">
      <h3><%= data.education.degree %></h3>
      <p class="edu-uni"><%= data.education.uni %></p>
      <p class="edu-spec">Specialisation: <strong><%= data.education.spec %></strong></p>
      <p class="edu-period"><%= data.education.period %></p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════
     CONTACT
══════════════════════════════════════════ -->
