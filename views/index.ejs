        </div>
        <div class="soc-info">
          <span class="soc-platform">GitHub</span>
          <span class="soc-handle">@withjayant</span>
        </div>
        <span class="soc-arrow">↗</span>
      </a>

      <a href="<%= data.personal.linkedin %>" target="_blank" class="soc-card linkedin">
        <div class="soc-icon-big">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </div>
        <div class="soc-info">
          <span class="soc-platform">LinkedIn</span>
          <span class="soc-handle">in/withjayant</span>
        </div>
        <span class="soc-arrow">↗</span>
      </a>

      <a href="<%= data.personal.leetcode %>" target="_blank" class="soc-card leetcode">
        <div class="soc-icon-big" style="font-size:1.6rem">🟡</div>
        <div class="soc-info">
          <span class="soc-platform">LeetCode</span>
          <span class="soc-handle"><%= data.dsa.totalSolved %>+ Solved</span>
        </div>
        <span class="soc-arrow">↗</span>
      </a>

      <a href="mailto:<%= data.personal.email %>" class="soc-card email">
        <div class="soc-icon-big" style="font-size:1.6rem">✉️</div>
        <div class="soc-info">
          <span class="soc-platform">Email</span>
          <span class="soc-handle"><%= data.personal.email %></span>
        </div>
        <span class="soc-arrow">↗</span>
      </a>

      <a href="tel:<%= data.personal.phone %>" class="soc-card phone">
        <div class="soc-icon-big" style="font-size:1.6rem">📱</div>
        <div class="soc-info">
          <span class="soc-platform">Phone</span>
          <span class="soc-handle"><%= data.personal.phone %></span>
        </div>
        <span class="soc-arrow">↗</span>
      </a>

      <div class="soc-card location" style="cursor:default">
        <div class="soc-icon-big" style="font-size:1.6rem">📍</div>
        <div class="soc-info">
          <span class="soc-platform">Location</span>
          <span class="soc-handle"><%= data.personal.location %></span>
        </div>
      </div>
